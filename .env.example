# 复制本文件为 .env 并填入真实值：cp .env.example .env
# MySQL/容器通用密码（本地测试可用简单密码，公网部署必须用强密码）
MYSQL_ROOT_PASSWORD=change-me
# Redis 密码
REDIS_PASSWORD=change-me
# QQ 邮箱 SMTP（用户名 + SMTP 授权码，非邮箱登录密码）
MAIL_USERNAME=your_qq@qq.com
MAIL_PASSWORD=your_smtp_authorization_code
# JWT 签名密钥：必须 ≥ 32 字节，用密码学随机数生成，例如 PowerShell：
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
# 智谱 GLM API Key（https://open.bigmodel.cn 控制台获取，GLM-4-Flash 免费）
GLM_API_KEY=your_zhipu_api_key
